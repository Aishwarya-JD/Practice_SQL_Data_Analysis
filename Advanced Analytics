-- 1. SELECT all records from the restaurants table.
USE SWIGGY;

SELECT * FROM RESTAURANTS;

-- 2. Rank every restaurant from most expensive to least expensive.
SELECT *, RANK()
OVER(ORDER BY cost DESC) AS r
FROM RESTAURANTS;

SELECT *, DENSE_RANK()
OVER(ORDER BY cost DESC) AS r
FROM RESTAURANTS;

-- 3. Rank every restaurant from most visited to least visited.
SELECT *, RANK()
OVER(ORDER BY rating_count DESC) AS r
FROM RESTAURANTS;

-- 4. Rank every restaurant from most expensive to least expensive as per their city.
SELECT *, RANK()
OVER(PARTITION BY city ORDER BY COST DESC) AS rank_by_city
FROM RESTAURANTS;

-- 5. Dense-rank every restaurant from most highest rated  to lowest rated as per their city.
SELECT * , DENSE_RANK()
OVER(PARTITION BY city ORDER BY rating DESC) AS dr_by_city
FROM RESTAURANTS;

-- 6. Row-number every restaurant from most expensive to least expensive as per their city.
SELECT *, ROW_NUMBER()
OVER(PARTITION BY city ORDER BY COST DESC) AS rn_by_city
FROM RESTAURANTS;

-- 7. Rank the restaurant based on their prices (most to least expensive) as per cuisine using rank, dense_rank, and row_number.
SELECT*, RANK()
OVER(PARTITION BY cuisine ORDER BY cost DESC) AS rank_by_cuisine
FROM RESTAURANTS;

SELECT*, DENSE_RANK()
OVER(PARTITION BY cuisine ORDER BY cost DESC) AS dense_rank_by_cuisine
FROM RESTAURANTS;

SELECT*, ROW_NUMBER()
OVER(PARTITION BY cuisine ORDER BY cost DESC) AS rn_by_cuisine
FROM RESTAURANTS;

-- 8. Find top 5 restaurants of every city as per their revenue.
SELECT *, RANK()
OVER(PARTITION BY city ORDER BY (rating_count * cost) DESC) AS rank_by_city_revenue
FROM RESTAURANTS LIMIT 5;

-- 9. Find top 5 restaurants of every cuisine as per their revenue.
SELECT *, RANK()
OVER(PARTITION BY cuisine ORDER BY (rating_count * cost) DESC) AS rank_by_cuisine_revenue
FROM RESTAURANTS LIMIT 5;

-- 10. List the top 5 cuisines as per the revenue generated by top 5 restaurants of every cuisine.
SELECT *, RANK()
OVER(PARTITION BY rating_count * cost ORDER BY (cuisine) DESC) AS rank_by_cuisine_revenue
FROM RESTAURANTS LIMIT 5;

-- 11. List the top 5 cities as per the revenue generated by top 5 restaurants of every city.
SELECT *, RANK()
OVER(PARTITION BY rating_count * cost ORDER BY (city) DESC) AS rank_by_city_revenue
FROM RESTAURANTS LIMIT 5;

-- 12. Find the total revenue generated by top 1% restaurants.
SELECT SUM(rating_count * cost) AS total_revenue FROM 
(SELECT *, cost*rating_count, ROW_NUMBER()
OVER(ORDER BY rating_count * cost DESC) AS rn_by_rev
FROM RESTAURANTS) t
WHERE t.rn_by_rev <= 614;
-- (SELECT COUNT(*) FROM RESTAURANTS / 100) = 614;

-- 13. Find the total revenue generated by top 20% restaurants.
select sum(cost * rating_count) as total_revenue from
(select *, cost * rating_count, row_number() over(order by cost * rating_count desc) as rn_by_rev
from restaurants) t
where t.rn_by_rev <= 12280;
-- (select count(*) from restaurants * 20 ) = 12280

-- 14. What percentage of total revenue is generated by top 20% restaurants?
with
	q1 as (select sum(cost * rating_count) as 'top_revenue' from
		  (select *, cost * rating_count, row_number() over(order by cost * rating_count desc) as 'rank'
		   from restaurants) t
            where t.rank <= 12280),
# (select count(*) from restaurants * 20 ) = 12280)
 q2 as (select sum(cost * rating_count) as 'total_revenue' from restaurants)
 
 select (top_revenue / total_revenue) * 100 as 'revenue %' from q1, q2;

