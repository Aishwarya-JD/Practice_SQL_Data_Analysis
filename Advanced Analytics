SELECT name, cost ,
if (cost <= 500, "Budget", "Expensive") AS label
FROM RESTAURANTS;

SELECT name, cost,
CASE 
	WHEN cost < 300 THEN "Budget"
	WHEN cost < 300 THEN "Mid"
	ELSE "Expensive"
END AS label
FROM RESTAURANTS;

